# =============================================================================
# HACKATHON SUBMISSION — .gitignore
# =============================================================================
# IMPORTANT: Never commit secrets, credentials, or large binary files.

# ── Secrets & Environment ─────────────────────────────────────────────────────
.env
.env.local
.env.production
*.key
*.pem
*.p12
secrets/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.Python
venv/
.venv/
env/
pip-log.txt
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
htmlcov/

# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn
dist/
.next/
.nuxt/
.output/
.cache/

# ── Java / Maven / Gradle ────────────────────────────────────────────────────
target/
*.class
*.jar
*.war
.gradle/
build/

# ── Go ────────────────────────────────────────────────────────────────────────
vendor/
*.exe

# ── Rust ──────────────────────────────────────────────────────────────────────
target/
Cargo.lock  # remove this line if you want to commit lock file (recommended for apps)

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Large Media Files (use demo-video-link.txt instead) ───────────────────────
demo/*.mp4
demo/*.mov
demo/*.avi
demo/*.mkv

# ── Docker volumes / local data ───────────────────────────────────────────────
data/
logs/
*.log

# ── Jupyter Notebooks (optional: remove if you want to commit notebooks) ──────
# .ipynb_checkpoints/

# ── Terraform ─────────────────────────────────────────────────────────────────
.terraform/
*.tfstate
*.tfstate.backup

# =============================================================================
# VERITY PROJECT-SPECIFIC
# =============================================================================

# Runtime data (ingested media, per-run artifacts)
workspace/

# Generated reports and saved analysis (output_dir in config/pipeline.yaml)
output/

# Built web console (npm run build in src/verity_ui)
src/verity_ui/dist/

# Model weights (dev-only, not distributed; fetched via scripts/download_detector_weights.py)
detectors/*/weights/*.pth

# Per-detector uv-managed environments (recreated on demand, see VERITY_DETECTOR_ENVS)
.detectorenvs/

# Non-project reference material (e.g. vendored DeepfakeBench checkout)
misc/
dist-bundle/

# Ad-hoc submission bundles (not part of the source tree)
*.zip

# Reference sample report (375MB, exceeds GitHub file size limit)
report.html
